Algoritmo "terreno"

Var
    preco,comprimento,metroQuadrado,area, largura : real



Inicio
       escreval("Digite a largura do terreno: ")
       leia(largura)
       escreval("Digite a area do terreno: ")
       leia(comprimento)
       escreval("Digite o valor do metroquadrado: ")
       leia(metroQuadrado)
       
       area <- largura * comprimento
       preco <- area * metroQuadrado

       escreval("Area do terreno: ", area:8:2)
       escreval("Preco do terreno: ", preco:8:2)


Fimalgoritmo
